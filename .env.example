# Copy to .env and fill every required value.
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
# Generate all three secrets with `npm run keys:generate`.
NEXTAUTH_SECRET="replace-me"

DATABASE_URL="postgresql://proof:proof@localhost:54329/proof_of_experience?schema=public"

# Generate with `npm run keys:generate`. Existing seals fail if this key changes.
RECORD_SIGNING_PRIVATE_KEY="replace-with-ed25519-pkcs8-base64"
DATA_ENCRYPTION_KEY="replace-with-32-byte-base64-key"

# Optional Google OAuth. Both variables must be set.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# local | s3 | vercel-blob
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./.data/uploads"

# Vercel Blob (only when STORAGE_DRIVER=vercel-blob). The Vercel integration sets this.
BLOB_READ_WRITE_TOKEN=""

# S3-compatible storage (only when STORAGE_DRIVER=s3)
S3_BUCKET=""
S3_REGION=""
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"

# Demo seed guard: set to true only if you intentionally seed demo accounts in production.
# ALLOW_DEMO_SEED="false"
